{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "docs/template-package/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ]
}
