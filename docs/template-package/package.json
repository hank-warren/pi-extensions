    "directory": "packages/pi-TEMPLATE"
  },
  "bugs": {
    "url": "https://github.com/hank-warren/pi-extensions/issues"
  },
  "homepage": "https://github.com/hank-warren/pi-extensions/tree/main/packages/pi-TEMPLATE#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
