{
  "name": "@hank-warren/pi-rex",
  "version": "0.1.0",
  "description": "Start Pi agents in Rex tabs from a Pi session: each child is a full interactive Pi the user can watch and type into, and its results, blocks and exits arrive in the parent as messages.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "rex",
    "subagents"
  ],
  "author": "Hank Warren",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hank-warren/pi-extensions.git",
    "directory": "packages/pi-rex"
  },
  "bugs": {
    "url": "https://github.com/hank-warren/pi-extensions/issues"
  },
  "homepage": "https://github.com/hank-warren/pi-extensions/tree/main/packages/pi-rex#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "parent.ts",
    "child.ts",
    "rex.ts",
    "spool.ts",
    "templates.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
