{
  "name": "@hank-warren/pi-agents",
  "version": "0.2.1",
  "description": "Subagents for Pi that look like Pi: each agent is its own pi --mode rpc process with your extensions and AGENTS.md, rendered with Pi's own components, watchable and steerable, with optional budgets and git worktrees.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "subagents",
    "agents",
    "rpc"
  ],
  "author": "Hank Warren",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hank-warren/pi-extensions.git",
    "directory": "packages/pi-agents"
  },
  "bugs": {
    "url": "https://github.com/hank-warren/pi-extensions/issues"
  },
  "homepage": "https://github.com/hank-warren/pi-extensions/tree/main/packages/pi-agents#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
